{
    "##": "PI-Desktop keeps state in ~/.pi-desktop and %APPDATA%\\PI-Desktop, both on C:, so an OS reinstall wipes them. installer.script migrates both into $persist_dir and replaces them with junctions, which is transparent to the app and preserves its single-instance lock. Persisted folders keep their original names (.pi-desktop, PI-Desktop) so they stay recognisable in $persist_dir. This is preferred over env_set (PI_DESKTOP_DATA_DIR) because setting that variable makes PI-Desktop skip requestSingleInstanceLock. After a reinstall, run install/update once more (or recreate the junctions by hand) to relink; data itself always survives in $persist_dir.",
    "version": "0.14.8",
    "description": "The desktop workspace for AI coding agents.",
    "homepage": "https://github.com/vastsa/PI-Desktop",
    "license": {
        "identifier": "LGPL-3.0-or-later",
        "url": "https://github.com/vastsa/PI-Desktop/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/vastsa/PI-Desktop/releases/download/v0.14.8/PI-Desktop-Portable-0.14.8.exe#/dl.7z",
            "hash": "09a594fadfe94ab80faa6cbf9565270c6c6fc5df89d866f729efbfd2dd7bc007",
            "pre_install": [
                "Get-Item \"$dir\\`$PLUGINSDIR\\app-64.7z\" | Expand-7zipArchive -DestinationPath \"$dir\" -Removal",
                "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue"
            ]
        }
    },
    "installer": {
        "script": [
            "# Relocate PI-Desktop state onto the Scoop drive and link it back with junctions.",
            "$links = @(",
            "    @{ Source = \"$env:USERPROFILE\\.pi-desktop\"; Target = \"$persist_dir\\.pi-desktop\"; Legacy = \"$persist_dir\\data\" },",
            "    @{ Source = \"$env:APPDATA\\PI-Desktop\";   Target = \"$persist_dir\\PI-Desktop\"; Legacy = \"$persist_dir\\appdata\" }",
            ")",
            "function Get-LinkItem($path) { Get-Item $path -Force -ErrorAction SilentlyContinue }",
            "# A junction whose destination was moved still passes Test-Path, so verify the",
            "# destination. Only genuine links are ever removed, never a plain directory.",
            "function Test-StaleLink($item) {",
            "    if (!$item -or !$item.LinkType) { return $false }",
            "    $dest = @($item.Target)[0]",
            "    return (!$dest) -or !(Test-Path $dest)",
            "}",
            "",
            "# Work out everything that has to change before touching the filesystem, so the",
            "# running-process guard below can cover the whole operation.",
            "$renames = @()",
            "$anyWork = $false",
            "foreach ($link in $links) {",
            "    # An earlier revision persisted into 'data'/'appdata'; rename once to the original name.",
            "    $legacyItem = Get-LinkItem $link.Legacy",
            "    if ($legacyItem -and !$legacyItem.LinkType -and !(Test-Path $link.Target)) {",
            "        $renames += $link",
            "        $anyWork = $true",
            "    }",
            "    # Renaming the destination above would leave the existing link dangling.",
            "    $willBeStale = $renames -contains $link",
            "    $sourceItem = Get-LinkItem $link.Source",
            "    if ($willBeStale -or (Test-StaleLink $sourceItem)) {",
            "        $anyWork = $true",
            "    } elseif ($sourceItem -and !$sourceItem.LinkType -and !(Test-Path $link.Target)) {",
            "        $anyWork = $true",
            "    } elseif (!$sourceItem -and !(Test-Path $link.Target)) {",
            "        $anyWork = $true",
            "    }",
            "}",
            "",
            "if ($anyWork) {",
            "    if (Get-Process -Name 'PI-Desktop' -ErrorAction SilentlyContinue) {",
            "        throw 'Close PI-Desktop first: its data has to be moved to the persist directory.'",
            "    }",
            "    New-Item $persist_dir -ItemType Directory -Force | Out-Null",
            "",
            "    foreach ($link in $renames) {",
            "        Move-Item $link.Legacy $link.Target -Force",
            "        Write-Host \"Renamed persisted folder: '$($link.Legacy)' -> '$($link.Target)'\" -ForegroundColor Green",
            "    }",
            "",
            "    foreach ($link in $links) {",
            "        $sourceItem = Get-LinkItem $link.Source",
            "        if (Test-StaleLink $sourceItem) {",
            "            Remove-Item $link.Source -Force -Recurse -ErrorAction SilentlyContinue",
            "            Write-Host \"Removed stale link at '$($link.Source)'\" -ForegroundColor Yellow",
            "            $sourceItem = $null",
            "        }",
            "        if ($sourceItem -and !$sourceItem.LinkType) {",
            "            if (Test-Path $link.Target) {",
            "                Write-Host \"Both '$($link.Source)' and '$($link.Target)' hold data; leaving '$($link.Source)' alone.\" -ForegroundColor Yellow",
            "                Write-Host \"Merge it into '$($link.Target)' by hand if it is newer, then reinstall to link it.\" -ForegroundColor Yellow",
            "                continue",
            "            }",
            "            Move-Item $link.Source $link.Target -Force",
            "            Write-Host \"Moved '$($link.Source)' -> '$($link.Target)'\" -ForegroundColor Green",
            "        }",
            "        if (!(Test-Path $link.Source)) {",
            "            if (!(Test-Path $link.Target)) { New-Item $link.Target -ItemType Directory -Force | Out-Null }",
            "            New-Item -ItemType Junction -Path $link.Source -Target $link.Target | Out-Null",
            "            Write-Host \"Linked '$($link.Source)' -> '$($link.Target)'\" -ForegroundColor Green",
            "        }",
            "    }",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "# Remove the junctions only; persisted data stays in $persist_dir.",
            "$links = @(",
            "    @{ Source = \"$env:USERPROFILE\\.pi-desktop\"; Target = \"$persist_dir\\.pi-desktop\" },",
            "    @{ Source = \"$env:APPDATA\\PI-Desktop\";   Target = \"$persist_dir\\PI-Desktop\" }",
            ")",
            "foreach ($link in $links) {",
            "    $item = Get-Item $link.Source -Force -ErrorAction SilentlyContinue",
            "    if ($item -and $item.LinkType) {",
            "        Remove-Item $link.Source -Force -Recurse -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "bin": "PI-Desktop.exe",
    "shortcuts": [
        [
            "PI-Desktop.exe",
            "PI-Desktop"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vastsa/PI-Desktop/releases/download/v$version/PI-Desktop-Portable-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/vastsa/PI-Desktop/releases",
            "jp": "$..assets[?(@.browser_download_url == '$url')].digest"
        }
    }
}
