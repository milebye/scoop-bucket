{
    "##": "PI-Desktop keeps state in ~/.pi-desktop and %APPDATA%\\PI-Desktop, both on C:, so an OS reinstall wipes them. installer.script moves them into $persist_dir and links them back with junctions, which is transparent to the app and preserves its single-instance lock. Preferred over env_set (PI_DESKTOP_DATA_DIR) because setting that variable makes PI-Desktop skip requestSingleInstanceLock. After a reinstall, run install/update once more to relink; data always survives in $persist_dir.",
    "version": "0.15.3",
    "description": "The desktop workspace for AI coding agents.",
    "homepage": "https://github.com/vastsa/PI-Desktop",
    "license": {
        "identifier": "LGPL-3.0-or-later",
        "url": "https://github.com/vastsa/PI-Desktop/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/vastsa/PI-Desktop/releases/download/v0.15.3/PI-Desktop-Portable-0.15.3.exe#/dl.7z",
            "hash": "d543dfdf9cfab694125dbcf11438de5ec6578988102bc1122c484e1a6f3942bc",
            "pre_install": [
                "Get-Item \"$dir\\`$PLUGINSDIR\\app-64.7z\" | Expand-7zipArchive -DestinationPath \"$dir\" -Removal",
                "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue"
            ]
        }
    },
    "installer": {
        "script": [
            "# Move PI-Desktop state onto the Scoop drive and link it back with junctions.",
            "Get-Process -Name 'PI-Desktop' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
            "if (!(Test-Path $persist_dir)) {",
            "    New-Item $persist_dir -Type Directory -Force | Out-Null",
            "}",
            "$runtimeCaches = @(",
            "    @{ Source = \"$env:USERPROFILE\\.pi-desktop\"; Target = \"$persist_dir\\.pi-desktop\" },",
            "    @{ Source = \"$env:APPDATA\\PI-Desktop\";   Target = \"$persist_dir\\appdata\" }",
            ")",
            "foreach ($cache in $runtimeCaches) {",
            "    if (Test-Path $cache.Source) {",
            "        $sourceItem = Get-Item $cache.Source -Force",
            "        if (!(($sourceItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0)) {",
            "            if (Test-Path $cache.Target) {",
            "                Copy-Item \"$($cache.Source)\\*\" $cache.Target -Recurse -Force -ErrorAction Stop",
            "                try {",
            "                    Remove-Item $cache.Source -Force -Recurse -ErrorAction Stop",
            "                } catch {",
            "                    throw \"Failed to prepare persisted path '$($cache.Source)'. Close PI-Desktop and retry. $($_.Exception.Message)\"",
            "                }",
            "            } else {",
            "                try {",
            "                    Move-Item $cache.Source $cache.Target -Force -ErrorAction Stop",
            "                } catch {",
            "                    throw \"Failed to migrate '$($cache.Source)' to '$($cache.Target)'. Close PI-Desktop and retry. $($_.Exception.Message)\"",
            "                }",
            "            }",
            "        }",
            "    } elseif (!(Test-Path $cache.Target)) {",
            "        New-Item $cache.Target -Type Directory -Force | Out-Null",
            "    }",
            "    if (!(Test-Path $cache.Source)) {",
            "        New-Item -Type Junction -Path $cache.Source -Target $cache.Target | Out-Null",
            "    }",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "Get-Process -Name 'PI-Desktop' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
            "$runtimeCaches = @(",
            "    @{ Source = \"$env:USERPROFILE\\.pi-desktop\"; Target = \"$persist_dir\\.pi-desktop\" },",
            "    @{ Source = \"$env:APPDATA\\PI-Desktop\";   Target = \"$persist_dir\\appdata\" }",
            ")",
            "foreach ($cache in $runtimeCaches) {",
            "    if (Test-Path $cache.Source) {",
            "        $sourceItem = Get-Item $cache.Source -Force",
            "        if (($sourceItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {",
            "            Remove-Item $cache.Source -Force -Recurse -ErrorAction SilentlyContinue",
            "        } elseif (!(Test-Path $cache.Target)) {",
            "            Move-Item $cache.Source $cache.Target -Force",
            "        } else {",
            "            Remove-Item $cache.Source -Force -Recurse -ErrorAction SilentlyContinue",
            "        }",
            "    }",
            "}"
        ]
    },
    "bin": "PI-Desktop.exe",
    "shortcuts": [
        [
            "PI-Desktop.exe",
            "PI-Desktop"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vastsa/PI-Desktop/releases/download/v$version/PI-Desktop-Portable-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/vastsa/PI-Desktop/releases",
            "jp": "$..assets[?(@.browser_download_url == '$url')].digest"
        }
    }
}
